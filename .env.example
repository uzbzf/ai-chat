# true — ответы из моков без backend; false — запросы к /api/chat (Gemini)
VITE_USE_MOCKS=false

# Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Основная модель; при 503 backend переключится на запасные из списка ниже
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.1-flash-lite,gemini-3.8-flash

PORT=3001

# Телефон автомастерской (перенаправление с off-topic вопросов)
WORKSHOP_PHONE=+7 (999) 123-45-67
VITE_WORKSHOP_PHONE=+7 (999) 123-45-67

# Префикс API для продакшена (в dev прокси Vite на :3001)
# VITE_API_BASE=https://your-api.example.com
